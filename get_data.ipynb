def get_stock_data(_page_num):
    options = Options()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.add_argument(f"--user-data-dir={tempfile.mkdtemp()}")

    browser = webdriver.Chrome(options=options)
    url = f'https://finance.naver.com/sise/sise_market_sum.naver?&=2&page={_page_num}'
    browser.get(url)

    # 체크박스 초기화 및 선택
    checkboxes = browser.find_elements(By.NAME, 'fieldIds')
    for checkbox in checkboxes:
        if checkbox.is_selected():
            checkbox.click()
    items_to_select = ['거래량', '전일거래량', 'PER', 'PBR', '외국인비율', '보통주배당금']
    for checkbox in checkboxes:
        parent = checkbox.find_element(By.XPATH, '..')
        label = parent.find_element(By.TAG_NAME, 'label')
        if label.text in items_to_select:
            checkbox.click()

    btn_apply = browser.find_element(By.XPATH, '//a[@href="javascript:fieldSubmit()"]')
    btn_apply.click()

    # 테이블이 로드될 때까지 최대 10초 대기
    try:
        WebDriverWait(browser, 10).until(
            EC.presence_of_element_located((By.CLASS_NAME, "type_2"))
        )
    except:
        print(f"⚠️ 페이지 {_page_num}에서 테이블 로딩 실패")
        browser.quit()
        return pd.DataFrame()

    try:
        df = pd.read_html(StringIO(browser.page_source))[1]
    except ValueError:
        print(f"⚠️ 페이지 {_page_num}에서 테이블을 찾을 수 없습니다.")
        browser.quit()
        return pd.DataFrame()

    df.dropna(axis='index', how='all', inplace=True)
    df.dropna(axis='columns', how='all', inplace=True)
    if "N" in df.columns:
        df.set_index("N", inplace=True)

    browser.quit()
    return df

def get_page_data(_end_page_num):
    df_all = pd.DataFrame()
    for i in range(1, _end_page_num + 1):
        print(f"Fetching page {i}...")
        df = get_stock_data(i)
        if df.empty:
            print(f"⚠️ 페이지 {i}는 데이터가 없어 건너뜁니다.")
            continue
        df_all = pd.concat([df_all, df], ignore_index=True)
    return df_all

